{
  "name": "mfe-runtime-config",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "start": "npm run start:shell",
    "start:shell": "ng serve shell --port 4200",
    "start:payments": "ng serve payments --port 4201",
    "start:all": "concurrently -k -n shell,payments \"npm:start:shell\" \"npm:start:payments\"",
    "build": "ng build payments --configuration production && ng build shell --configuration production",
    "build:shell": "ng build shell --configuration production",
    "build:payments": "ng build payments --configuration production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ng lint shell && ng lint payments"
  },
  "dependencies": {
    "@angular-architects/native-federation": "21.2.5",
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/platform-browser": "21.2.22",
    "@angular/router": "21.2.22",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.7",
    "@angular-eslint/builder": "21.0.1",
    "@angular-eslint/eslint-plugin": "21.0.1",
    "@angular-eslint/eslint-plugin-template": "21.0.1",
    "@angular-eslint/schematics": "21.0.1",
    "@angular-eslint/template-parser": "21.0.1",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.22",
    "@types/node": "24.3.0",
    "concurrently": "9.2.1",
    "eslint": "9.34.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vitest": "3.2.4"
  }
}
